# ===== 계정 정보 템플릿 =====
# 이 파일(.env.example)은 GitHub에 올려도 되는 "빈 양식"입니다.
# 실제 값은 .env 파일에 채워 넣으세요. .env 는 .gitignore 로 커밋에서 제외됩니다.
#
# 사용법:
#   1) 이 파일을 복사해 .env 로 이름 변경
#   2) 아래 값을 본인 계정 정보로 채우기
#   3) .env 는 절대 GitHub에 올리지 마세요 (이미 .gitignore 에 포함됨)

# --- GitHub ---
GITHUB_USERNAME=your-github-username
GITHUB_EMAIL=your-email@example.com
# Personal Access Token (repo 권한). https://github.com/settings/tokens 에서 발급
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# 올릴 저장소 이름
GITHUB_REPO=game0919

# --- Render (https://render.com) ---
RENDER_EMAIL=your-email@example.com
# Render 대시보드 > Account Settings > API Keys 에서 발급 (선택 사항)
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxx
# 배포 후 생성되는 서비스 주소 (배포 후 채우기)
RENDER_SERVICE_URL=https://game0919.onrender.com
